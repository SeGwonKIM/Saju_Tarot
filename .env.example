# ============================================================
#  사주·타로 리포트 — 환경변수 예시  (PRD §12.10 비밀값 대장)
#
#  규칙
#   1. 이 파일에는 키 "이름"만 적는다. 실제 값도, 값의 형태(sk-ant-…)도 적지 않는다.
#   2. 실제 값은 .env(로컬) 와 배포 플랫폼 설정 화면(운영)에만 넣는다.
#   3. .env 는 .gitignore 로 막혀 있다. 절대 커밋하지 않는다.
#   4. ★ 표시는 최우선 등급 — 유출 시 요금 폭탄 또는 DB 전체 노출.
#      운영 값은 로컬 개발 머신에 두지 않는다(별도 dev 키를 쓴다).
# ============================================================

# ── backend/.env (Render 환경변수) ──────────────────────────

# ★ Claude API 키 — 유출 시 요금 폭탄
ANTHROPIC_API_KEY=CHANGE_ME

# ★ Supabase service_role — RLS를 무시하고 DB 전체에 접근한다
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ★ 개인정보 필드 암호화 키 (32바이트 난수 base64, PRD §12.14)
#    생성: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME

# Supabase 프로젝트 URL (비밀 아님)
SUPABASE_URL=CHANGE_ME

# DB 직접 접속 문자열
DATABASE_URL=CHANGE_ME

# CORS 허용 오리진 — 쉼표 구분. 와일드카드(*) 금지 (PRD §12.4)
ALLOWED_ORIGINS=http://localhost:5173

# 개인정보 보관 기간 (PRD §12.9)
DATA_RETENTION_DAYS=90
ANON_RETENTION_DAYS=7

# 실행 환경: local | production
APP_ENV=local


# ── frontend/.env (Cloudflare Pages 환경변수) ───────────────
#  ⚠️ VITE_ 접두사가 붙은 값은 브라우저 번들에 그대로 들어간다.
#     = "공개해도 되는 값"만 넣는다. 비밀값 절대 금지. (PRD §12.1)

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase anon 키 — 공개 전제. 방어선은 RLS다 (PRD §4.4)
VITE_SUPABASE_ANON_KEY=CHANGE_ME

# 목업 데이터 사용 여부 (PRD §7)
VITE_USE_MOCK=true
